{
  "name": "nexus-notes",
  "version": "2.1.3",
  "description": "NEXUS — 離線筆記應用（桌面版）",
  "license": "MIT",
  "author": "NEXUS",
  "main": "main.js",
  "scripts": {
    "sync": "node build.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder",
    "dist:mac": "npm run sync && electron-builder --mac dmg zip",
    "dist:win": "npm run sync && electron-builder --win nsis",
    "dist:linux": "npm run sync && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nexus.notes",
    "productName": "NEXUS",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "fileAssociations": [
      {
        "ext": "noteapp",
        "name": "NEXUS Note",
        "description": "NEXUS 筆記檔",
        "role": "Editor",
        "rank": "Owner",
        "icon": "build/icon.icns"
      },
      {
        "ext": "json",
        "name": "JSON Note",
        "description": "NEXUS / JSON 筆記檔",
        "role": "Editor",
        "rank": "Alternate",
        "icon": "build/icon.icns"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "txt",
        "name": "Plain Text",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "png",
        "name": "PNG Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "jpg",
        "name": "JPEG Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "jpeg",
        "name": "JPEG Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
